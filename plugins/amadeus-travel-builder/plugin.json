{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "amadeus-travel-builder",
  "version": "1.0.1",
  "description": "Build applications including travel-related capabilities on live Amadeus data with Amadeus Travel Builder APIs. Expose flight search, tour and activity recommendations, real-time pricing and booking links, airport and city lookup, and other travel capabilities with no API docs to read first.",
  "author": {
    "name": "Amadeus",
    "url": "https://github.com/AmadeusITGroup"
  },
  "homepage": "https://github.com/AmadeusITGroup/amadeus-travel-toolkit",
  "repository": "https://github.com/AmadeusITGroup/amadeus-travel-toolkit",
  "license": "Apache-2.0",
  "keywords": [
    "amadeus",
    "travel",
    "flights",
    "flight-search",
    "fare-comparison",
    "tours",
    "activities",
    "experiences",
    "recommendations",
    "airline",
    "iata",
    "icao",
    "airport",
    "city",
    "autocomplete"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "shortDescription": "Build travel apps with Amadeus",
        "websiteURL": "https://amadeus.com",
        "supportURL": "https://github.com/AmadeusITGroup/amadeus-travel-toolkit/issues",
        "privacyPolicyURL": "https://amadeus.com/en/policies/travel-builder/privacy",
        "termsOfServiceURL": "https://amadeus.com/en/policies/travel-builder/terms",
        "composerIcon": "./icon.png",
        "logo": "./icon.png"
      }
    }
  }
}
